# ---------------------------------------------------------------------------
# IntelliInventory configuration. Copy to .env - every value here is optional.
# The defaults run 100% free: SQLite + the built-in offline agent planner.
# ---------------------------------------------------------------------------

# AI provider: auto | hermes | offline      (100% free - no paid API anywhere)
#   auto = Hermes if configured or a local Ollama Hermes model is running, else the offline planner
AI_PROVIDER=auto

# --- Hermes (Nous Research) — FREE when run locally with Ollama ---------------
#   1) install https://ollama.com   2) ollama pull hermes3:3b   3) start the app - auto-detected, no key needed
# HERMES_MODEL=hermes3:3b        # ~2 GB, any 8 GB laptop.  hermes3 (8B) is smarter but needs ~16 GB RAM
# OLLAMA_URL=http://localhost:11434
# Other OpenAI-compatible hosts (Nous Portal, OpenRouter, vLLM, LM Studio, llama.cpp):
# HERMES_BASE_URL=https://inference-api.nousresearch.com/v1
# HERMES_API_KEY=
# HERMES_MODEL=Hermes-4-70B
# HERMES_TOOL_MODE=native   # or "prompt" = Hermes <tool_call> XML format (for servers without tool support)

# --- Deployment mode -------------------------------------------------------------------
# DEMO_MODE=true  -> sample Indian shop data + demo logins shown on the login page (for a public demo link)
# DEMO_MODE=false -> your real business: empty catalogue, one admin account from the values below
DEMO_MODE=true
# ADMIN_EMAIL=you@yourshop.in
# ADMIN_NAME=Owner
# ADMIN_PASSWORD=choose-a-strong-password   (if unset, a random one is printed in the server log once)
# PUBLIC_URL=https://your-space.hf.space      (used for MCP / webhook links when deployed)

# --- GST (optional) -----------------------------------------------------------------------
# Not GST-registered? set false (or switch it off in Settings -> Business & GST). Slabs are editable in the UI.
GST_ENABLED=true

# --- Security (change in production!) -----------------------------------------------
SECRET_KEY=change-me-in-production-intelliinventory-secret
INTEGRATION_TOKEN=hermes-dev-token
DEMO_PASSWORD=demo1234

# --- Data ---------------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://intelli:intelli@localhost:5432/intelliinventory
#   free hosted Postgres: Neon (neon.tech) - paste its postgres:// URL, it is converted automatically
# SEED_DEMO_DATA=true   # defaults to DEMO_MODE

# --- Automation -------------------------------------------------------------------------
AUTOPILOT_ENABLED=true
AUTOPILOT_COOLDOWN_HOURS=12
# PO_BUDGET_LIMIT=2000000      # budget_guard plugin (₹20 lakh)
# PLUGINS_DIR=/path/to/your/plugins
