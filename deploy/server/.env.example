# Copy to deploy/server/.env (setup.sh does this for you and fills the secrets).
DEMO_MODE=false
ADMIN_EMAIL=you@yourshop.in
ADMIN_NAME=Owner
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-long-random
INTEGRATION_TOKEN=change-me-random
POSTGRES_PASSWORD=change-me-random
HERMES_MODEL=hermes3:3b
# https -> Caddy on DOMAIN (open ports 80 + 443)   |   tunnel -> free trycloudflare.com link   |   empty -> http://<ip>:8000
COMPOSE_PROFILES=https
DOMAIN=localhost
PUBLIC_URL=https://localhost
