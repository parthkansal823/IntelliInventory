# Copy to deploy/server/.env (setup.sh does this for you and fills the secrets).
DEMO_MODE=false
ADMIN_EMAIL=you@yourshop.in
ADMIN_NAME=Owner
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-long-random
INTEGRATION_TOKEN=change-me-random
POSTGRES_PASSWORD=change-me-random
HERMES_MODEL=hermes3:3b
# https -> Caddy on DOMAIN (open ports 80 + 443) | demo -> public demo copy on DEMO_DOMAIN (or :8001)
# tunnel -> free trycloudflare.com link | combine with commas, e.g. https,demo
COMPOSE_PROFILES=https,demo
DOMAIN=localhost
DEMO_DOMAIN=demo.localhost
PUBLIC_URL=https://localhost
